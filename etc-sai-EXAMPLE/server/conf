# these are the sai server global settings
#
# stuff related to each vhosts should go in one
# file per vhost in ./conf.d/

{
  "global": {
   "uid": "48", # after init, run as apache user
   "gid": "48", # after init, run as apache group
   "server-string": "sai",
   "init-ssl": "yes",
   # lws's plugins, for lws-log-ingest, which keeps the fleet logs
   "plugin-dir": "/usr/local/share/libwebsockets-test-server/plugins"
 }
}

